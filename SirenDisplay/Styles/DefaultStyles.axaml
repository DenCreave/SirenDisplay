<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="10">
            <!-- Add controls for Previewer here -->
            <Label Classes="icon" Content="&#xE9B8;"/>
            
        </Border>
        
        
    </Design.PreviewWith>
    <!-- Add Styles Here -->
    
    <Style Selector="Label.icon" > <!-- make a label that can do icons, nothing else tho --> 
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"></Setter>
    </Style>
</Styles>
