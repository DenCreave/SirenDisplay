<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:SirenDisplay.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="480"
        Background="Black"
        x:Class="SirenDisplay.MainWindow"
        Title="SirenDisplay"
        x:DataType="viewModels:MainViewModel">
    
    
    
    <Design.DataContext>
        <viewModels:MainViewModel></viewModels:MainViewModel>
    </Design.DataContext>
    <Window.Resources>
        
    </Window.Resources>
    
    
    <!-- WindowState="Maximized"  -->
    
    
    
    <Grid x:Name="BaseGrid"   RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">
        <Button Grid.Row="0" Foreground="#ff901b" FontSize="25" HorizontalAlignment="Center"> erre lesz rá bindolva a song vagy playlist neve</Button>
        <Path Grid.Row="0"   Stroke="#ff901b" StrokeThickness="10" Margin="5" Stretch="Fill">
                
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,100">
                        <LineSegment Point="800,100"/>
                        <LineSegment Point="800,0"/>
                        <LineSegment Point="100,0"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Effect>
                <DropShadowEffect Color="#ff901b" Opacity="1" BlurRadius="500"/>
            </Path.Effect>
            <Path.Fill>
                <SolidColorBrush Color="#ff901b" Opacity=".05"  ></SolidColorBrush>
            </Path.Fill>
        </Path>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*">
            
        </Grid>
        <Path Grid.Row="1"   Stroke="#ff901b" StrokeThickness="10" Margin="5" Stretch="Fill">
                
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="0,100">
                        <LineSegment Point="0,380"/>
                        <LineSegment Point="800,380"/>
                        <LineSegment Point="800,100"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Effect>
                <DropShadowEffect Color="#ff901b" Opacity="1" BlurRadius="500"/>
            </Path.Effect>
            <Path.Fill>
                <SolidColorBrush Color="#ff901b" Opacity=".05"  ></SolidColorBrush>
            </Path.Fill>
        </Path>
        
        <Path Grid.Row="1"  Stroke="#ff901b" Stretch="Fill"  StrokeThickness="1" Margin="5" >
            <Path.Data>
                
                <PathGeometry Figures="{Binding TestGeometry}"> <!-- top coordinate-->
                   
                 
                 
                 
                </PathGeometry> <!-- a path geometrybe kell rakni  a path figureket -->
            </Path.Data>
            <Path.Effect>
                <DropShadowEffect Color="#ff901b" Opacity="1" BlurRadius="500"/>
            </Path.Effect>
            <Path.Fill>
                <SolidColorBrush Color="#ff901b" Opacity=".45"  ></SolidColorBrush>
            </Path.Fill>
        </Path>
        
        
        
        
        
        
        
