        <Path Grid.Row="2"  Stroke="#ff901b" StrokeThickness="10" Margin="5" Stretch="Fill">
            <Path.Data>
                <PathGeometry > <!-- talán ide tudok rakni majd a bindingot -->
                    <PathFigure StartPoint="0,380">
                        <LineSegment Point="0,480"/>
                        <LineSegment Point="700,480"/>
                        <LineSegment Point="800,380"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Effect>
                <DropShadowEffect Color="#ff901b" Opacity="1" BlurRadius="500"/>
            </Path.Effect>
            <Path.Fill>
                <SolidColorBrush Color="#ff901b" Opacity=".05"  ></SolidColorBrush>
            </Path.Fill>
        </Path>
        <Label Grid.Row="1" Content="{Binding TesztNeked}"> </Label>
        <Button Grid.Row="2" HorizontalAlignment="Center" Foreground="#ff901b" FontSize="24" Background="Transparent"  Content="{Binding TestObject}">
            <Button.Effect>
                <DropShadowEffect Color="#ff901b" Opacity="1" BlurRadius="50"/>
            </Button.Effect>
             
        </Button> 
        
    </Grid>
    
    
</Window>